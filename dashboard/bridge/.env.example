# ==========================================
# AirVent Bridge Service - Environment Variables
# ==========================================
# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
#   cp .env.example .env
#
# ⚠️  .env는 절대 Git에 커밋하지 마세요.

# ---------- Supabase ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- MQTT Broker ----------
# Naver Cloud MQTT 브로커 정보
MQTT_HOST=mqtt://your-broker-host:1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC=env/SML001/+/data

# ---------- Solana ----------
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=B4m1ENS6SWV3H6mZkJ2VFkBKawqYe7atH4AjXoc4NZzR
SOLANA_AIR_MINT=BXV4ewBjMB1qmXjU3bc14SfXHQbseFhRy5xE4RtHtvsL

# 서버 지갑 키 파일 경로 (절대경로 권장)
# ⚠️  이 파일도 절대 Git에 커밋 금지
BRIDGE_WALLET_PATH=/Users/user/.config/solana/airvent-bridge.json

# ---------- Optional ----------
# 디바이스 등록 스크립트(register.ts)에서 사용
DEVICE_ID=5EBHA10001
