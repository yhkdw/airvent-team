# Example only: use ONLY if there is no existing SSL 443 server block for mqtt.airvent.ai.
# Do not overwrite existing Nginx/certbot configuration.
server {
  listen 443 ssl;
  server_name mqtt.airvent.ai;
  ssl_certificate /etc/letsencrypt/live/mqtt.airvent.ai/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/mqtt.airvent.ai/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  location = /v1/air-quality/stream {
    proxy_pass http://127.0.0.1:3108;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 700s;
    gzip off;
    access_log off;
  }
  location / { return 404; }
}
