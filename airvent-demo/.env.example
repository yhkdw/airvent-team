# ==========================================
# AirVent Demo (Mobile Pairing App) - Env Vars
# ==========================================
# 이 파일을 복사해서 .env로 만드세요:
#   cp .env.example .env
#
# 모든 키는 Vite 클라이언트 번들에 포함되므로 (VITE_ 접두사)
# 절대 service_role 키 등 서버 전용 시크릿을 넣지 마세요.

# ---------- Supabase (anon key — 클라이언트용) ----------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------- Solana (기본값으로도 Devnet 동작) ----------
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_PROGRAM_ID=B4m1ENS6SWV3H6mZkJ2VFkBKawqYe7atH4AjXoc4NZzR
VITE_SOLANA_AIR_MINT=BXV4ewBjMB1qmXjU3bc14SfXHQbseFhRy5xE4RtHtvsL

# ---------- Demo Fallback ----------
# 사용자가 Phantom 미연결 상태일 때 잔액 표시용 fallback 지갑 (브리지 서버 지갑)
VITE_DEMO_SERVER_WALLET=GUyFB5qJvPMRZweeL8fb7KQDdRicArQCTyAw64dkRyHw
