  "metadata": {
    "description": "Created with Anchor",
    "name": "airvent_contract",
    "spec": "0.1.0",
    "version": "0.1.0"
  },
  "types": [
    {
      "docs": [
        "Event emitted when IoT device submits data"
      ],
      "name": "DataSubmitted",
      "type": {
        "fields": [
          {
            "docs": [
              "Device identifier"
            ],
            "name": "device_id",
            "type": "string"
          },
          {
            "docs": [
              "Timestamp of submission"
            ],
            "name": "timestamp",
            "type": "i64"
          },
          {
            "docs": [
              "PM2.5 air quality measurement in μg/m³ × 10",
              "Example: 35.2 μg/m³ = 352",
              "Precision: 1 decimal place"
            ],
            "name": "pm25",
            "type": "u32"
          },
          {
            "docs": [
              "PM10 air quality measurement in μg/m³ × 10",
              "Example: 50.1 μg/m³ = 501",
              "Precision: 1 decimal place"
            ],
            "name": "pm10",
            "type": "u32"
          },
          {
            "docs": [
              "Temperature in Celsius × 10",
              "Example: 25.3°C = 253",
              "Precision: 1 decimal place"
            ],
            "name": "temperature",
            "type": "i32"
          },
          {
            "docs": [
              "Humidity percentage × 10",
              "Example: 65.5% = 655",
              "Precision: 1 decimal place"
            ],
            "name": "humidity",
            "type": "u32"
          },
          {
            "docs": [
              "Reward amount earned for this submission"
            ],
            "name": "reward_amount",
            "type": "u64"
          },
          {
            "docs": [
              "Current halving epoch (0, 1, 2, ...)"
            ],
            "name": "halving_epoch",
            "type": "u64"
          },
          {
            "docs": [
              "Device owner at time of submission"
            ],
            "name": "owner",
            "type": "pubkey"
          }
        ],
        "kind": "struct"
      }
    },
    {
      "docs": [
        "Device Registry Account",
        "Stores information about a registered IoT device"
      ],
      "name": "DeviceRegistry",
      "type": {
        "fields": [
          {
            "docs": [
              "Unique device identifier (e.g., serial number)"
            ],
            "name": "device_id",
            "type": "string"
          },
          {
            "docs": [
              "Owner's wallet address"
            ],
            "name": "owner",
            "type": "pubkey"
          },
          {
            "docs": [
              "Timestamp when device was registered"
            ],
            "name": "registered_at",
            "type": "i64"
          },
          {
            "docs": [
              "Whether the device is currently active"
            ],
            "name": "is_active",
            "type": "bool"
          }
        ],
        "kind": "struct"
      }
    },
    {
      "docs": [
        "Device's reward statistics",
        "Rewards are automatically distributed on each data submission"
      ],
      "name": "DeviceRewards",
      "type": {
        "fields": [
          {
            "docs": [
              "Device ID this reward account belongs to"
            ],
            "name": "device_id",
            "type": "string"
          },
          {
            "docs": [
              "Current owner of the device (updated on ownership transfer)"
            ],
            "name": "owner",
            "type": "pubkey"
          },
          {
            "docs": [
              "Total data submissions by this device"
            ],
            "name": "total_data_submitted",
            "type": "u64"
          },
          {
            "docs": [
              "Last submission timestamp"
            ],
            "name": "last_submission",
            "type": "i64"
          }
        ],
        "kind": "struct"
      }
    },
    {
      "docs": [
        "Global reward configuration with halving mechanism"
      ],
      "name": "RewardConfig",
      "type": {
        "fields": [
          {
            "docs": [
              "Authority that can modify config (treasury authority)"
            ],
            "name": "authority",
            "type": "pubkey"
          },
          {
            "docs": [
              "Official AIR token mint (fixed)"
            ],
            "name": "mint",
            "type": "pubkey"
          },
          {
            "docs": [
              "Treasury token account (fixed)"
            ],
            "name": "treasury",
            "type": "pubkey"
          },
          {
            "docs": [
              "Initial reward per data submission (in smallest units)"
            ],
            "name": "initial_reward",
            "type": "u64"
          },
          {
            "docs": [
              "Timestamp when reward system started (for time-based halving)"
            ],
            "name": "start_timestamp",
            "type": "i64"
          },
          {
            "docs": [
              "Total data submissions across all devices (statistics)"
            ],
            "name": "total_data_submitted",
            "type": "u64"
          },
          {
            "docs": [
              "Total rewards distributed (in tokens, automatically)"
            ],
            "name": "total_rewards_distributed",
            "type": "u64"
          }
        ],
        "kind": "struct"
      }
    }
  ]
}